PORT=4001
DB_HOST=localhost
DB_PORT=3306
DB_NAME=time_mask
DB_USER=
DB_PASSWORD=
DB_CHARSET=utf8mb4
DB_CONNECTION_LIMIT=10
DB_QUEUE_LIMIT=0
GOOGLE_API_KEY=
GOOGLE_MODEL=gemini-3.8-flash
# Optional comma-separated models tried if the primary model is temporarily overloaded.
GOOGLE_MODEL_FALLBACKS=gemini-3.7-flash,gemini-3.6-flash,gemini-3.5-flash
# Active provider: google or openai. An administrator can change this in Settings.
LLM_PROVIDER=google
JWT_SECRET=replace-with-a-random-secret-at-least-32-characters
JWT_EXPIRES_IN=7d
CORS_ORIGIN=http://localhost:5173,https://time-masks.vercel.app
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
